# LiveSpec local
.claude/commands/spec.*.md
.claude/agents/livespec-*.md
.specs/.livespec-path
.specs/hooks/*.local.md
test-results/
playwright-report/

# Generated LiveSpec runtime evidence (canonical spec/plan/mappings remain tracked)
.specs/.runs/
.specs/.execution/
.specs/conventions/runs/
.specs/features/*/.reviews/
.specs/features/*/reviews/
.specs/features/*/run/
.specs/features/*/runs/
.specs/features/*/logs/
__pycache__/
.pytest_cache/
.ruff_cache/

# LiveSpec transient finalization lock (canonical metadata stays tracked).
.specs/.LOCK

# Feature 009 native allocator sentinel; canonical feature files remain visible.
.specs/features/009-decision-models/.reserved
# Generated by the native commit-context API (LiveSpec system/hooks.md).
.specs/hooks/.commit-context.json

# Preflight report — ignore new reports; exclude existing tracked report changes from selective delivery
.specs/preflight-report.md
